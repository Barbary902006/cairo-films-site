---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stills from '../components/Stills.astro';
import Laurels from '../components/Laurels.astro';
import { href, useTranslations, type Lang } from '../i18n/utils';
import { getFilms, localize, paragraphs } from '../lib/films';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const films = await getFilms();
---

<Base lang={lang} title={t('press.title')} description={t('press.intro')}>
  <section class="section">
    <div class="wrap">
      <h1 class="page-title">{t('press.title')}</h1>
      <p class="prose">{t('press.intro')}</p>
      <nav class="toc" aria-label={t('press.title')}>
        {films.map((film) => <a href={`#${film.id}`}>{localize(film, lang).title}</a>)}
      </nav>
    </div>
  </section>

  {
    films.map((film) => {
      const f = localize(film, lang);
      return (
        <section class="section kit" id={film.id}>
          <div class="wrap">
            <div class="kit-head">
              <a class="poster" href={f.poster.src} target="_blank" rel="noopener">
                <Image src={f.poster} alt={`${t('press.poster')}: ${f.title}`} widths={[300, 600]} sizes="12rem" loading="lazy" />
              </a>
              <div>
                <p class="status">{t(`status.${f.status}` as const)}</p>
                <h2>
                  <a href={href(`/films/${film.id}/`, lang)}>{f.title}</a>
                </h2>
                <p class="facts">
                  {[f.format, f.year, f.runtime].filter(Boolean).join(' · ')} · {t('film.directedBy')} {f.director}
                </p>
                <Laurels laurels={f.laurels} />
                <div class="btn-row">
                  <a class="btn" href={href(`/press/${film.id}.txt`, lang)} download={`${film.id}-synopsis.txt`}>
                    {t('press.downloadSynopsis')}
                  </a>
                  <a class="btn" href={f.poster.src} download={`${film.id}-poster.${f.poster.format}`}>
                    {t('press.poster')}
                  </a>
                  {f.pressKitFile && (
                    <a class="btn" href={href(f.pressKitFile)} download>
                      {t('press.downloadFull')}
                    </a>
                  )}
                </div>
              </div>
            </div>

            <div class="cols">
              <div>
                <h3 class="eyebrow">{t('press.logline')}</h3>
                <p class="logline">{f.logline}</p>
                <h3 class="eyebrow">{t('film.synopsis')}</h3>
                <div class="prose">{paragraphs(f.synopsis).map((p) => <p>{p}</p>)}</div>
              </div>
              {f.credits.length > 0 && (
                <div>
                  <h3 class="eyebrow">{t('film.credits')}</h3>
                  <dl class="credits">
                    {f.credits.map((c) => (
                      <div>
                        <dt>{c.role}</dt>
                        <dd>{c.name}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </div>

            {f.stills.length > 0 && (
              <>
                <h3 class="eyebrow stills-label">{t('film.stills')}</h3>
                <Stills stills={f.stills} slug={film.id} lang={lang} downloads />
              </>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="section">
    <div class="wrap">
      <p class="lead">{t('press.requests')}</p>
      <a class="btn" href={href('/contact/', lang)}>{t('nav.contact')} <span class="arrow">→</span></a>
    </div>
  </section>
</Base>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-block-start: 2rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .kit {
    scroll-margin-top: 4.5rem;
  }
  .kit-head {
    display: grid;
    grid-template-columns: minmax(7rem, 12rem) 1fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    margin-block-end: 3rem;
  }
  @media (max-width: 520px) {
    .kit-head {
      grid-template-columns: 1fr;
    }
    .poster {
      max-width: 12rem;
    }
  }
  .poster {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    margin-block: 0.5rem 0.75rem;
  }
  h2 a {
    text-decoration: none;
  }
  .facts {
    color: var(--ink-mute);
    font-size: 0.9rem;
  }
  .kit-head :global(.laurels) {
    margin-block: 1.25rem;
  }
  .btn-row {
    margin-block-start: 1.5rem;
  }
  .cols {
    display: grid;
    gap: 2.5rem;
    margin-block-end: 3rem;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 1.6fr 1fr;
      gap: 5rem;
    }
  }
  .logline {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.35;
    max-width: 36ch;
    margin-block-end: 2rem;
  }
  .credits {
    margin: 0;
  }
  .credits > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.65rem;
    border-block-end: 1px solid var(--rule);
  }
  dt {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    align-self: center;
  }
  dd {
    margin: 0;
    text-align: end;
  }
  .stills-label {
    margin-block-start: 1rem;
  }
  .lead {
    margin-block-end: 1.5rem;
  }
</style>
