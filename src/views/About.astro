---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { useTranslations, type Lang } from '../i18n/utils';
import { getPage } from '../lib/films';
import portrait from '../assets/portrait.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const page = (await getPage('about', lang))!;
const { Content } = await render(page);
---

<Base lang={lang} title={page.data.title} description={page.data.description} image={portrait}>
  <section class="section">
    <div class="wrap grid">
      <div class="portrait">
        <Image src={portrait} alt={site.name} widths={[400, 800, 1200]} sizes="(max-width: 860px) 90vw, 28rem" loading="eager" />
      </div>
      <div>
        <p class="eyebrow">{t('about.title')}</p>
        <h1 class="page-title">{site.name}</h1>
        <div class="prose"><Content /></div>
      </div>
    </div>
  </section>

  {
    page.data.highlights.length > 0 && (
      <section class="section">
        <div class="wrap">
          <p class="eyebrow">{t('about.highlights')}</p>
          <dl class="highlights">
            {page.data.highlights.map((h) => (
              <div>
                <dt>{h.label}</dt>
                <dd>
                  {h.detail}
                  {h.year && <span class="year">{h.year}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
</Base>

<style>
  .grid {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: minmax(16rem, 28rem) 1fr;
    }
    .portrait {
      position: sticky;
      top: 6rem;
    }
  }
  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-raised);
    max-width: 28rem;
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0;
    margin: 0;
    border-block-start: 1px solid var(--rule);
  }
  .highlights > div {
    padding: 1.5rem 0;
    padding-inline-end: 2rem;
    border-block-end: 1px solid var(--rule);
  }
  dt {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.2;
    margin-block-end: 0.35rem;
  }
  dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .year {
    color: var(--ink-mute);
    margin-inline-start: 0.5rem;
  }
</style>
