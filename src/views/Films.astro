---
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { getFilms } from '../lib/films';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const films = await getFilms();
---

<Base lang={lang} title={t('films.title')} description={t('films.intro')}>
  <section class="section">
    <div class="wrap">
      <h1 class="page-title">{t('films.title')}</h1>
      <p class="lead">{t('films.intro')}</p>
      <div class="grid">
        {films.map((film) => <FilmCard film={film} lang={lang} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }
</style>
