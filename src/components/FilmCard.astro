---
import { Image } from 'astro:assets';
import { href, useTranslations, type Lang } from '../i18n/utils';
import { localize, type Film } from '../lib/films';

interface Props {
  film: Film;
  lang: Lang;
}
const { film, lang } = Astro.props;
const t = useTranslations(lang);
const f = localize(film, lang);
---

<article class="card">
  <a href={href(`/films/${film.id}/`, lang)} class="link">
    <div class="poster">
      <Image src={f.poster} alt={f.title} widths={[400, 700]} sizes="(max-width: 700px) 90vw, 30rem" />
    </div>
    <p class="status">{t(`status.${f.status}` as const)}</p>
    <h2>{f.title}</h2>
    <p class="meta">{[f.format, f.year].filter(Boolean).join(' · ')}</p>
    <p class="meta">{t('film.directedBy')} {f.director}</p>
    <p class="logline">{f.logline}</p>
  </a>
</article>

<style>
  .link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-raised);
    margin-block-end: 1.25rem;
  }
  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.3s;
    opacity: 0.92;
  }
  .link:hover .poster :global(img) {
    transform: scale(1.025);
    opacity: 1;
  }
  .status {
    margin-block-end: 0.5rem;
  }
  h2 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin-block-end: 0.5rem;
    transition: color 0.2s;
  }
  .link:hover h2 {
    color: var(--accent);
  }
  .meta {
    font-size: 0.85rem;
    color: var(--ink-mute);
    margin: 0;
  }
  .logline {
    margin-block-start: 0.9rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    max-width: 34rem;
  }
</style>
